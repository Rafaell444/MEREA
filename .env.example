# ============================================================
#  Tezenis headless storefront — environment variables
#  Copy to .env locally; on Vercel add the same keys in Project → Settings → Environment Variables
# ============================================================

# ---------- Shopify store ----------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Storefront API (from the "Headless" sales channel app → Storefront API → tokens)
#  - public token: used if no private token is set
#  - private token: preferred for server-to-server calls (this app only calls Shopify from the server)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Admin API (custom app "Merea api" → API credentials → Admin API access token, starts with shpat_)
# Used only by the admin panel: orders, customers, notes, tags. Never sent to the browser.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Markets context for @inContext (match Shopify → Settings → Markets)
SHOPIFY_COUNTRY=RU
SHOPIFY_LANGUAGE=RU

# Webhook signing secret (Shopify → Settings → Notifications → Webhooks) → https://<site>/api/webhooks/shopify
SHOPIFY_WEBHOOK_SECRET=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Merea

# ---------- Database (PostgreSQL; on Vercel: Storage → Neon/Postgres fills DATABASE_URL automatically) ----------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Supabase direct connection (Dashboard → Connect → Direct, port 5432) — used only by prisma db push / seed
DIRECT_URL=

# ---------- Media storage on Vercel (Storage → Blob → token). Leave empty locally to store uploads in public/uploads ----------
BLOB_READ_WRITE_TOKEN=
# (or MEREA_READ_WRITE_TOKEN if the Blob store was created with the MEREA prefix)

# ---------- Admin security ----------
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Initial admin user created by the seed (change the password after first login)
ADMIN_EMAIL=admin@merea.ru
ADMIN_PASSWORD=

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_YANDEX_METRIKA_ID=
